<Project>
  <PropertyGroup>
    <!--
      Workshop-only setting: NuGetAudit surfaces transitive CVEs inside the
      Distro's own dependency closure (e.g. OpenTelemetry.Api 1.14.0,
      System.Security.Cryptography.Xml 9.0.0) which we cannot patch ourselves.
      Disabling the audit keeps `dotnet build /warnaserror` green for the
      workshop. Real production projects should re-enable this and pin
      transitive versions explicitly.
    -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!--
    Semantic version fallback. Local builds use 1.0.0; CI/CD overrides every
    version property via GitVersion (GitTools) by passing /p:Version=<SemVer>
    (and InformationalVersion) to `dotnet build` / `dotnet publish`. The running
    app reads AssemblyInformationalVersion and reports it to Application Insights
    as application_Version (service.version). See GitVersion.yml.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <InformationalVersion Condition="'$(InformationalVersion)' == ''">$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
